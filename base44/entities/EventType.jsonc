{
  "name": "EventType",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique key e.g. MEE, GEE, DDE"
    },
    "display_name": {
      "type": "string"
    },
    "participation_type": {
      "type": "string",
      "enum": [
        "ranked",
        "yn"
      ],
      "default": "ranked"
    },
    "has_prep_stage": {
      "type": "boolean",
      "default": false
    },
    "has_war_stage": {
      "type": "boolean",
      "default": false
    },
    "prep_top20_enabled": {
      "type": "boolean",
      "default": false,
      "description": "If true, Prep Stage splits players into Top XX (by power) and Outside groups"
    },
    "war_top20_enabled": {
      "type": "boolean",
      "default": true,
      "description": "If true, War Stage splits players into Top XX (by power) and Outside groups"
    },
    "top_split_rank_cutoff": {
      "type": "number",
      "default": 20,
      "description": "Configurable cutoff (XX): the top XX players by power form the 'Top' group; this also defines the override range for outside players who claim ranks 1..XX"
    },
    "dkp_table_prep": {
      "type": "string",
      "description": "JSON array of DKP values per rank (unified prep, used when prep_top20_enabled is false)"
    },
    "dkp_table_prep_top20": {
      "type": "string",
      "description": "JSON array of DKP for Prep Top group players"
    },
    "dkp_table_prep_outside": {
      "type": "string",
      "description": "JSON array of DKP for Prep Outside group players"
    },
    "prep_top20_fallback": {
      "type": "number",
      "default": 20,
      "description": "Fallback DKP for Prep Top group players beyond table"
    },
    "prep_outside_fallback": {
      "type": "number",
      "default": 0,
      "description": "Fallback DKP for Prep Outside players beyond table"
    },
    "dkp_table_war_top20": {
      "type": "string",
      "description": "JSON array"
    },
    "dkp_table_war_outside": {
      "type": "string",
      "description": "JSON array"
    },
    "war_top20_fallback": {
      "type": "number",
      "default": 20,
      "description": "Fallback DKP for War Top group players beyond table"
    },
    "war_outside_fallback": {
      "type": "number",
      "default": 0,
      "description": "Fallback DKP for War Outside players beyond table"
    },
    "dkp_yn_present": {
      "type": "number",
      "default": 5
    },
    "dkp_yn_absent": {
      "type": "number",
      "default": -5
    },
    "war_ranking_cutoff": {
      "type": "number",
      "default": 100
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "display_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}