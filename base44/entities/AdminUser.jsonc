{
  "name": "AdminUser",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique admin username"
    },
    "password_hash": {
      "type": "string",
      "description": "Bcrypt hashed password"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this admin account is active"
    }
  },
  "required": [
    "username",
    "password_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}