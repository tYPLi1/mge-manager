{
  "name": "MeritsHistory",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "Reference to Player"
    },
    "player_name": {
      "type": "string"
    },
    "merits": {
      "type": "number",
      "description": "Merits value recorded"
    },
    "recorded_at": {
      "type": "string",
      "format": "date",
      "description": "Date of recording"
    },
    "source": {
      "type": "string",
      "description": "Source of merits data (manual, upload, etc.)"
    }
  },
  "required": [
    "player_id",
    "merits",
    "recorded_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}