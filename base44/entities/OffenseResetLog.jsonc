{
  "name": "OffenseResetLog",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "offense_count": {
      "type": "number"
    },
    "offense_date": {
      "type": "string",
      "format": "date"
    },
    "eligible_reset_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "probation",
        "reset"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "player_id",
    "offense_count",
    "offense_date",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}